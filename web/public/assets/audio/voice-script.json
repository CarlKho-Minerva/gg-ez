[{"key": "R.2:lia", "text": "HAHAHA. Grabe.", "speaker": "lia", "file": "voice-r-2-lia"}, {"key": "R.3:lia", "text": "Sorry, whoever you are.", "speaker": "lia", "file": "voice-r-3-lia"}, {"key": "R.4:lia", "text": "Actually, not sorry.", "speaker": "lia", "file": "voice-r-4-lia"}, {"key": "R.5:lia", "text": "Ay, sayop nga window.", "speaker": "lia", "file": "voice-r-5-lia"}, {"key": "C2:lia", "text": "Five-star meal.", "speaker": "lia", "file": "voice-c2-lia"}, {"key": "C3:lia", "text": "Michelin, where’s my award?", "speaker": "lia", "file": "voice-c3-lia"}, {"key": "C4:lia", "text": "Ay. Free vegetable.", "speaker": "lia", "file": "voice-c4-lia"}, {"key": "N2:lia", "text": "Okay, last one. Promise.", "speaker": "lia", "file": "voice-n2-lia"}, {"key": "V2.6:lia", "text": "Thank you for calling. My name is Lia. How may I help you today?", "speaker": "lia", "file": "voice-v2-6-lia"}, {"key": "C1.2:caller", "text": "I was told this would be fixed yesterday.", "speaker": "caller", "file": "voice-c1-2-caller"}, {"key": "C1.3:lia", "text": "I'm sorry about the delay, sir. Let me check the status for you.", "speaker": "lia", "file": "voice-c1-3-lia"}, {"key": "C1.4:lia", "text": "Yes, sir. I'm checking the latest update.", "speaker": "lia", "file": "voice-c1-4-lia"}, {"key": "C1.4:caller", "text": "Are you even listening?", "speaker": "caller", "file": "voice-c1-4-caller"}, {"key": "C1.5:caller", "text": "Then why does nobody there know what they're doing?", "speaker": "caller", "file": "voice-c1-5-caller"}, {"key": "C1.6:lia", "text": "I understand why you're frustrated.", "speaker": "lia", "file": "voice-c1-6-lia"}, {"key": "C1.7:lia", "text": "Of course. Before I transfer you, I can confirm the refund is still processing. I'm sorry I couldn't resolve it today.", "speaker": "lia", "file": "voice-c1-7-lia"}, {"key": "C1.7:caller", "text": "Can I speak to somebody else?", "speaker": "caller", "file": "voice-c1-7-caller"}, {"key": "C1.9:lia", "text": "Sir, if shouting made refunds faster, I'd be shouting with you.", "speaker": "lia", "file": "voice-c1-9-lia"}, {"key": "C1.10:lia", "text": "Kana. Customer empathy.", "speaker": "lia", "file": "voice-c1-10-lia"}, {"key": "C1.11:lia", "text": "Grabe. Unsa pa may gusto nila?", "speaker": "lia", "file": "voice-c1-11-lia"}, {"key": "C1.12:lia", "text": "Okay. Next time.", "speaker": "lia", "file": "voice-c1-12-lia"}, {"key": "P.5:lia", "text": "Naay gulay. Technically.", "speaker": "lia", "file": "voice-p-5-lia"}, {"key": "K.5:lia", "text": "At least sa game, kabalo ko nga maayo ko.", "speaker": "lia", "file": "voice-k-5-lia"}, {"key": "N.5:lia", "text": "Usa pa.", "speaker": "lia", "file": "voice-n-5-lia"}, {"key": "E.6:lia", "text": "Okay. Kaya pa.", "speaker": "lia", "file": "voice-e-6-lia"}, {"key": "E.7:lia", "text": "Thank you for calling. My name is Lia. How may I help you?", "speaker": "lia", "file": "voice-e-7-lia"}]